  "app": {
    "windows": [
      {
        "title": "Smart OR Triage",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzRTQ4RDQwRjk2MjU0OUYKUldTZlZHTDVRSTNrZ3l3a2g5UTdnbG1wUGJoV1k4Z2xhTTNxcXlQK3kvRU55TEd2STNXNFlzQnAK",
      "endpoints": [
        "https://github.com/stevedaydream/ORtable/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
